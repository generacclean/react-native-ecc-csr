{
  "name": "@generacclean/react-native-ecc-csr",
  "version": "2.0.0-beta.1",
  "description": "Secure ECC KeyPair + CSR generation for Android & iOS",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "files": [
    "android",
    "!android/build",
    "!android/build/**",
    "!android/.gradle",
    "!android/.gradle/**",
    "ios",
    "src",
    "expo-module.config.json"
  ],
  "keywords": [
    "react-native",
    "android",
    "keystore",
    "ecc",
    "csr",
    "certificate",
    "pkcs10",
    "bouncycastle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generacclean/react-native-ecc-csr.git"
  },
  "author": "Ved Yedla",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react-native": ">=0.83.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo": "~55.0.31",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "typescript": "~5.9.2"
  }
}
